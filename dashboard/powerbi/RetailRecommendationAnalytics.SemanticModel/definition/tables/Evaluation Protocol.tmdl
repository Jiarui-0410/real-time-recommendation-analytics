	partition 'Evaluation Protocol' = m
		mode: import
		source =
				let
							Source = PostgreSQL.Database(
								"localhost:5432",
								"retail_analytics",
								[CreateNavigationProperties=false]
							),
							Data = Source{[Schema="public", Item="recommendation_evaluation_protocol"]}[Data]
						in
							Data

