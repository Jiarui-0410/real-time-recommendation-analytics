table 'Evaluation Protocol'
	lineageTag: f905bcfb-2b29-4542-8bf7-6fc3995444d1

	measure 'Evaluated User Count' = MAX('Evaluation Protocol'[Evaluated Users])
		formatString: #,0
		lineageTag: da0f9ed3-bbbf-4d0a-b167-fd2ebf610fe0

	measure 'Warm User Count' = MAX('Evaluation Protocol'[Warm Users])
		formatString: #,0
		lineageTag: 0f0c7a33-2df9-4e99-95ae-83be5ae92e0d

	measure 'Cold User Count' = MAX('Evaluation Protocol'[Cold Users])
		formatString: #,0
		lineageTag: 92a284d8-52a4-4d6d-865f-4d21aeb0d8c0

	measure 'Cold Start Share' = DIVIDE(MAX('Evaluation Protocol'[Cold Users]), MAX('Evaluation Protocol'[Evaluated Users]))
		formatString: 0.0%
		lineageTag: 4035877b-7949-45e9-8309-6ff4b943cc9d

	measure 'Coverage Lift' = VAR TT = CALCULATE(MAX('Recommendation Metrics'[Metric Value]), FILTER(ALL('Recommendation Metrics'), 'Recommendation Metrics'[Cohort] = "Overall" && 'Recommendation Metrics'[Model] = "Two-Tower + fallback" && 'Recommendation Metrics'[Metric] = "catalog_coverage@10")) VAR Pop = CALCULATE(MAX('Recommendation Metrics'[Metric Value]), FILTER(ALL('Recommendation Metrics'), 'Recommendation Metrics'[Cohort] = "Overall" && 'Recommendation Metrics'[Model] = "Popularity" && 'Recommendation Metrics'[Metric] = "catalog_coverage@10")) RETURN DIVIDE(TT, Pop)
		formatString: 0.0x
		lineageTag: 27c5b9d9-493b-4f71-83e2-cb74f57bc579

	column ID
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 18f82750-52be-466c-910e-82edc3d7431e
		summarizeBy: none
		sourceColumn: id

	column 'Sampled Users'
		dataType: int64
		formatString: #,0
